  "requirements": [
    {
      "id": "FR-001",
      "text": "The existing source-only AppLab orchestration contract must map read-only jobs and deny untrusted source, scope, and write authority while retaining AppLab as the sole durable scheduler.",
      "status": "PROPOSED",
      "conflicts_with": [],
      "acceptance": [
        {
          "id": "AC-001",
          "criterion": "A read-only AppLab WorkItem preserves resolved SHA, includes no code-edit permission and cannot declare runtime verification, dispatch or merge.",
          "evidence_type": "UNIT_TEST"
        },
        {
          "id": "AC-002",
          "criterion": "An untrusted job that expands allowed paths beyond trusted policy is denied before scheduling or worker execution.",
          "evidence_type": "UNIT_TEST"
        },
        {
          "id": "AC-003",
          "criterion": "A lease claim with a mismatched immutable source SHA is rejected before a WorkItem is issued.",
          "evidence_type": "UNIT_TEST"
        },
        {
          "id": "AC-004",
          "criterion": "A write attempt without an independently signed approval receipt is denied before any queue or workspace effects.",
          "evidence_type": "UNIT_TEST"
        }
      ]
    }
  ],
