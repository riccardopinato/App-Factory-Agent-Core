{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riccardopinato/App-Factory-Agent-Core/blob/main/contracts/job.schema.json",
  "title": "AgentJobDesignV1",
  "description": "CONTRACT DESIGN: not implemented by a runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "target",
    "mode",
    "request",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256
    },
    "mode": {
      "enum": [
        "analyze",
        "propose_diff",
        "run_tests",
        "prepare_pr"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 10000
        },
        "issue_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_attempts"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "model_token_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": {
          "const": false
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
